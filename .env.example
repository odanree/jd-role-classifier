# Database
DATABASE_URL=postgresql+asyncpg://portfolio_user:changeme@localhost:5432/jd_role_classifier

# NLP settings
SPACY_MODEL=en_core_web_sm
MOCK_NLP=false           # Set to true for dev/CI without GPU (keyword-based fallback)

# Classifier settings
LOAD_CLASSIFIER=false    # Set to true once fine-tuned model is available
MODEL_PATH=              # Path to fine-tuned BERT+LoRA weights (set if LOAD_CLASSIFIER=true)
HF_MODEL_NAME=google-bert/bert-base-uncased

# Beacon DB (read-only, for seeding + LLM-labeling from job-search-pipeline).
# Both seed_from_beacon.py and llm_label_corpus.py use asyncpg, which rejects
# SQLAlchemy-style driver prefixes (`postgresql+asyncpg://`, `postgresql+psycopg2://`).
# Use a plain `postgresql://` DSN. Default values assume the local SSH tunnel
# created by portfolio-infra/scripts/beacon-tunnel.ps1.
BEACON_DATABASE_URL=postgresql://jsp_user:changeme@127.0.0.1:15436/job_search

# App
APP_ENV=development
API_KEY=

# Anthropic API key — used by scripts/llm_label_corpus.py to bootstrap
# the labeled training corpus. Not consumed by the running classifier
# service; safe to leave unset unless you're running the labeler.
ANTHROPIC_API_KEY=
