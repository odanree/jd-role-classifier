# Database
DATABASE_URL=postgresql+asyncpg://portfolio_user:changeme@localhost:5432/jd_role_classifier

# NLP settings
SPACY_MODEL=en_core_web_sm
MOCK_NLP=false           # Set to true for dev/CI without GPU (keyword-based fallback)

# Classifier settings
LOAD_CLASSIFIER=false    # Set to true once fine-tuned model is available
MODEL_PATH=              # Path to fine-tuned BERT+LoRA weights (set if LOAD_CLASSIFIER=true)
HF_MODEL_NAME=google-bert/bert-base-uncased

# Beacon DB (read-only, for seeding from job-search-pipeline)
BEACON_DATABASE_URL=postgresql+psycopg2://user:changeme@localhost:5432/beacon

# App
APP_ENV=development
API_KEY=
